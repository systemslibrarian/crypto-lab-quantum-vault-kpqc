{
  "name": "quantum-vault-web-demo",
  "version": "5.1.0",
  "private": true,
  "type": "module",
  "description": "Quantum Vault — threshold cryptography demo: AES-256-GCM + Shamir SSS + SMAUG-T Level 1 KEM + HAETAE Mode 2 signature (real KpqC WASM)",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:typescript && tsc --noEmit && vite build",
    "check:typescript": "node --test tests/tooling.node.mjs",
    "deploy": "gh workflow run deploy-pages.yml --repo systemslibrarian/crypto-lab-quantum-vault-kpqc --ref main",
    "preview": "vite preview",
    "test": "vitest run && node --test tests/*.node.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test e2e/a11y.spec.ts",
    "test:e2e:install": "playwright install --with-deps chromium",
    "lint": "eslint src/"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "eslint": "^10.13.0",
    "playwright": "^1.61.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "^22.19.0 || ^24.0.0 || >=26.0.0"
  }
}
